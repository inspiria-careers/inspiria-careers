rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFileSize() {
      // Max 5 MB = 5 * 1024 * 1024 bytes
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isValidMimeType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('image/.*');
    }

    // Public Assets (Gallery, counsellor photos, website branding)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Client Private Vault: /clients/{userId}/{fileName}
    match /clients/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileSize() && isValidMimeType();
      allow delete: if isOwner(userId);
    }

    // Payment Screenshots (Protected: Owner only)
    match /payments/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileSize() && isValidMimeType();
      allow delete: if isOwner(userId);
    }

    // Counsellor Shared Resources & Worksheets (PDF, Audio, Images)
    match /resources/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidFileSize();
      allow delete: if isAuthenticated();
    }

    // Secure Messaging Attachments (Phase 6 Part A)
    match /messages/{clientId}/{fileName} {
      allow read, write: if isAuthenticated() && isValidFileSize() && isValidMimeType();
      allow delete: if isAuthenticated();
    }
  }
}
